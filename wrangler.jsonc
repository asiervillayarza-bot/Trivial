// Configuración de Cloudflare: un Worker que sirve la web (public/) y las salas de juego (Durable Objects).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trivial",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,     // la web se publica en https://trivial.<subdominio>.workers.dev
  "preview_urls": false,   // Cloudflare no admite enlaces de prueba en Workers con Durable Objects
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{"name": "SALAS", "class_name": "Sala"}]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["Sala"]}
  ],
  "observability": {"enabled": true},

  // Web de pruebas (https://trivial-pruebas.<subdominio>.workers.dev): se publica con
  // «npx wrangler deploy --env pruebas» desde la rama de trabajo, para probar los cambios antes de pasarlos a main.
  "env": {
    "pruebas": {
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{"name": "SALAS", "class_name": "Sala"}]
      }
    }
  }
}
